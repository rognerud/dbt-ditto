lts": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:55:57.660912Z", "completed_at": "2026-09-10T06:55:57.663484Z"}, {"name": "execute", "started_at": "2026-09-10T06:55:57.665488Z", "completed_at": "2026-09-10T06:55:57.665490Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.008062124252319336, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.platform.dim_customers", "compiled": true, "compiled_code": "\n\nwith orders as (\n\n    select\n        customer_id,\n        count(*) as lifetime_order_count,\n        sum(amount_cents) as lifetime_value_cents\n    from \"warehouse\".\"main\".\"stg_orders\"\n    group by 1\n\n)\n\nselect\n    c.customer_id,\n    c.first_name,\n    c.last_name,\n    c.signup_country,\n    coalesce(o.lifetime_order_count, 0) as lifetime_order_count,\n    coalesce(o.lifetime_value_cents, 0) as lifetime_value_cents\nfrom \"warehouse\".\"main\".\"stg_customers\" as c\nleft join orders as o on c.customer_id = o.customer_id", "relation_name": "\"warehouse\".\"main\".\"dim_customers\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:55:57.661612Z", "completed_at": "2026-09-10T06:55:57.663881Z"}, {"name": "execute", "started_at": "2026-09-10T06:55:57.665245Z", "completed_at": "2026-09-10T06:55:57.665247Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.005831241607666016, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.platform.dim_customer_keys", "compiled": true, "compiled_code": "-- Upstream spells these lower case; inheritance has to match case-insensitively.\nselect\n    customer_id as \"CUSTOMER_ID\",\n    signup_country as \"Signup_Country\"\nfrom \"warehouse\".\"main\".\"stg_customers\"", "relation_name": "\"warehouse\".\"main\".\"dim_customer_keys\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:55:57.664463Z", "completed_at": "2026-09-10T06:55:57.665700Z"}, {"name": "execute", "started_at": "2026-09-10T06:55:57.667091Z", "completed_at": "2026-09-10T06:55:57.667093Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.0029709339141845703, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.platform.stg_orders_enriched", "compiled": true, "compiled_code": "-- Two upstreams document `status` and `order_id` differently: the seed-backed\n-- stg_orders and the CRM source. Inheritance has to pick one deterministically.\nselect\n    o.order_id,\n    o.customer_id,\n    o.order_date,\n    o.status,\n    o.amount_cents,\n    s.amount_cents as source_amount_cents\nfrom \"warehouse\".\"main\".\"stg_orders\" as o\njoin \"warehouse\".\"main\".\"stg_source_orders\" as s on o.order_id = s.order_id", "relation_name": "\"warehouse\".\"main\".\"stg_orders_enriched\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:55:57.662982Z", "completed_at": "2026-09-10T06:55:57.665100Z"}, {"name": "execute", "started_at": "2026-09-10T06:55:57.666865Z", "completed_at": "2026-09-10T06:55:57.666867Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004186868667602539, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.platform.int_orders_passthrough", "compiled": true, "compiled_code": "-- Deliberately has no YAML file at all: an \"empty middle\" model that\n-- documentation has to travel through to reach the marts below it.\nselect\n    order_id,\n    customer_id,\n    order_date,\n    status,\n    amount_cents\nfrom \"warehouse\".\"main\".\"stg_orders\"", "relation_name": "\"warehouse\".\"main\".\"int_orders_passthrough\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:55:57.666244Z", "