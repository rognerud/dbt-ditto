      "path": "marts/dim_customers.sql",
      "fqn": ["bqshop", "marts", "dim_customers"],
      "config": {"materialized": "table", "dbt-osmosis": "_{model}.yml"},
      "columns": {},
      "depends_on": {"nodes": ["model.bqshop.stg_customers"]}
    },
    "model.bqshop.fct_customer_totals": {
