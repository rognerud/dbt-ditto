      "relation_name": "`bq-project`.`analytics`.`stg_customers`",
      "original_file_path": "models/staging/stg_customers.sql",
      "patch_path": "bqshop://models/staging/_stg_customers.yml",
      "path": "staging/stg_customers.sql",
      "fqn": ["bqshop", "staging", "stg_customers"],
      "description": "One row per customer, straight from the CRM extract.",
      "config": {"materialized": "table", "dbt-osmosis": "_{model}.yml"},
      "columns": {
        "customer_id": {
          "name": "customer_id",
          "description": "Surrogate key for a customer.",
          "data_type": "INT64",
          "config": {"meta": {"owner": "platform-team", "pii": false}, "tags": ["primary_key"]}
        },
        "email": {
          "name": "email",
          "description": "Customer contact address, restricted.",
          "data_type": "STRING",
          "policy_tags": ["projects/bq-project/locations/eu/taxonomies/1/policyTags/2"],
          "config": {"meta": {"owner": "platform-team", "pii": true}}
        },
        "customer.first_name": {
          "name": "customer.first_name",
          "description": "Customer given name, as typed by the customer.",
          "data_type": "STRING",
          "config": {"meta": {"pii": true}}
        },
        "customer.address.city": {
          "name": "customer.address.city",
          "description": "City of the customer's billing address.",
          "data_type": "STRING",
          "config": {"meta": {"pii": true}}
        },
        "lifetime_value": {
          "name": "lifetime_value",
          "description": "Lifetime gross revenue from the customer.",
          "data_type": "NUMERIC(38, 9)",
          "config": {"meta": {"owner": "finance-team"}}
        }
      },
      "depends_on": {"nodes": ["source.bqshop.crm.raw_customers"]}
    },
    "model.bqshop.dim_customers": {
